        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කිසිවක් උඩුගත නොවේ. ඔබේ ඡායාරූප සහ අසාත්මිකතා කිසිවිටෙක මෙම උපාංගයෙන් පිටතට නොයයි."
