    "Nothing on this label conflicts with your profile.": {
      "extractionState": "manual",
      "localizations": {
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම ලේබලයේ ඔබේ පැතිකඩට පටහැනි කිසිවක් නැත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த லேபிளில் உங்கள் சுயவிவரத்துடன் முரண்படுவது எதுவும் இல்லை."
          }
        }
      }
    },
    "There is something here you should know about.": {
      "extractionState": "manual",
      "localizations": {
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ දැනගත යුතු දෙයක් මෙහි ඇත."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "நீங்கள் அறிந்திருக்க வேண்டிய ஒன்று இங்கே உள்ளது."
          }
        }
      }
    },
    "This product conflicts with your profile.": {
      "extractionState": "manual",
      "localizations": {
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම නිෂ්පාදනය ඔබේ පැතිකඩට පටහැනියි."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்தப் பொருள் உங்கள் சுயவிவரத்துடன் முரண்படுகிறது."
          }
        }
      }
    },
