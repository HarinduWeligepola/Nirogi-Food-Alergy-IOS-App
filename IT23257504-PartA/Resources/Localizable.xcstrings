    "Pick anything you need to avoid. You can change these at any time, and set how serious each one is later." : {
      "extractionState" : "manual",
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබට වළක්වා ගත යුතු ඕනෑම දෙයක් තෝරන්න. ඔබට ඕනෑම වේලාවක මේවා වෙනස් කළ හැකි අතර, පසුව එක් එක් දේ කොතරම් බරපතළද යන්න සැකසිය හැක."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் தவிர்க்க வேண்டிய எதையும் தேர்ந்தெடுக்கவும். இவற்றை எப்போது வேண்டுமானாலும் மாற்றலாம், ஒவ்வொன்றும் எவ்வளவு தீவிரமானது என்பதைப் பின்னர் அமைக்கலாம்."
