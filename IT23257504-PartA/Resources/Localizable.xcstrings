    "You have not added any allergens yet, so every label will come back Safe." : {
      "extractionState" : "manual",
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ තවම අසාත්මිකතා එක් කර නැත, එබැවින් සෑම ලේබලයක්ම ආරක්ෂිත ලෙස පෙන්වයි."
          }
        },
        "ta" : {
