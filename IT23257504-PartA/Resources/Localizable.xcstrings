          }
        }
      }
    },
    "Open the Scan tab and photograph an ingredient label to get started.": {
      "extractionState": "manual",
      "localizations": {
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ආරම්භ කිරීමට ස්කෑන් ටැබය විවෘත කර අමුද්‍රව්‍ය ලේබලයක් ඡායාරූප ගන්න."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "தொடங்க ஸ்கேன் தாவலைத் திறந்து ஒரு பொருட்கள் லேபிளைப் புகைப்படம் எடுக்கவும்."
          }
        }
      }
    },
    "Know before you eat": {
