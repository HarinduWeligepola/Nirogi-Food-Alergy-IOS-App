      }
    },
    "Tap Scan a new label above and photograph an ingredient list to get started." : {
      "extractionState" : "manual",
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ආරම්භ කිරීමට ඉහත නව ලේබලයක් ස්කෑන් කරන්න තට්ටු කර අමුද්‍රව්‍ය ලැයිස්තුවක් ඡායාරූප ගන්න."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தொடங்க மேலே உள்ள புதிய லேபிளை ஸ்கேன் செய்யவும் என்பதைத் தட்டி, பொருட்கள் பட்டியலைப் புகைப்படம் எடுக்கவும்."
          }
        }
      }
    },
    "Tap the pin button above while you are at the shop to tag your most recent scan with this location." : {

    },
    "The text is split into individual ingredients." : {

    },
    "There is something here you should know about." : {
      "extractionState" : "manual",
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ඔබ දැනගත යුතු දෙයක් මෙහි ඇත."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் அறிந்திருக்க வேண்டிய ஒன்று இங்கே உள்ளது."
          }
        }
      }
    },
    "These are real scans: each image is read by Vision exactly like a photo from the camera." : {
      "extractionState" : "manual",
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මේවා සැබෑ ස්කෑන් වේ: සෑම රූපයක්ම කැමරාවෙන් ගත් ඡායාරූපයක් මෙන් Vision මගින් කියවනු ලැබේ."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இவை உண்மையான ஸ்கேன்கள்: ஒவ்வொரு படமும் கேமரா புகைப்படம் போலவே Vision ஆல் படிக்கப்படுகிறது."
          }
        }
      }
    },
    "This product conflicts with your profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම නිෂ්පාදනය ඔබේ පැතිකඩට පටහැනියි."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தப் பொருள் உங்கள் சுயவிவரத்துடன் முரண்படுகிறது."
