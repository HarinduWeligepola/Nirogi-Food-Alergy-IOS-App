    "It knows that casein means dairy and umbalakada means fish — even when the label does not say so." : {
      "extractionState" : "manual",
      "localizations" : {
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "කැසීන් යනු කිරි බවත් උම්බලකඩ යනු මාළු බවත් එය දනී — ලේබලයේ එසේ සඳහන් නොවූවත්."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கேசீன் என்றால் பால் என்றும் உம்பலகடா என்றால் மீன் என்றும் இது அறியும் — லேபிளில் அவ்வாறு குறிப்பிடப்படாவிட்டாலும்."
